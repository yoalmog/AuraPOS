<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dedicated Immersive POS Theme (Hides status bar and action bar for full-screen terminal operation) -->
    <style name="Theme.AuraPOS.Immersive" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackground">#0F172A</item>
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
    </style>
</resources>
