# ==============================================================================
# AuraPOS Environment Configuration Template (.env.example)
# PRODUCTION IMPLEMENTATION: Strict separation of Client vs Server Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Studio & Host Environment Variables
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Server-side only key for menu scanning & catalog OCR
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet/backend is hosted (Cloud Run service URL)
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 2. CLIENT-SAFE / PUBLIC SUPABASE CONFIGURATION (Android APK & Web Office Client)
#    SAFE to include in Android / Web Office client bundles.
#    Uses public anonymous key restricted by PostgreSQL Row Level Security (RLS).
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ------------------------------------------------------------------------------
# 3. SERVER-ONLY SECRETS (NEVER EMBED IN ANDROID APK OR CLIENT-SIDE BUNDLES)
#    CRITICAL: SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security.
#    MUST ONLY be configured on server-side environments (Node.js Express / Edge Functions).
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 4. BACKEND API AUTHENTICATION & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Shared key for authorized backend calls if Supabase auth JWT is not used.
AURA_API_KEY=""
VITE_AURA_API_KEY=""

# Extra browser origins allowed to call the backend (comma-separated).
# https://appassets.androidplatform.net is always allowed for Android WebView.
ALLOWED_ORIGINS=""

